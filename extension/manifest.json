{
  "manifest_version": 3,
  "name": "WatchWeb - Website Change Monitor",
  "version": "1.0.0",
  "description": "Watch anything on a website and get notified when the meaningful content changes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchWeb"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "110"
}
