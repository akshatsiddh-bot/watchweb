{
  "name": "watchweb-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node -e \"const fs=require('fs'); fs.mkdirSync('dist/utils',{recursive:true}); fs.mkdirSync('dist/icons',{recursive:true}); fs.copyFileSync('manifest.json','dist/manifest.json'); fs.copyFileSync('src/background/background.js','dist/background.js'); fs.copyFileSync('src/utils/config.js','dist/utils/config.js'); fs.copyFileSync('src/content/content.js','dist/content.js'); fs.readdirSync('public/icons').filter(f=>f.endsWith('.png')).forEach(f=>fs.copyFileSync('public/icons/'+f,'dist/icons/'+f));\"",
    "lint": "eslint src"
  },
  "dependencies": {
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3"
  }
}
