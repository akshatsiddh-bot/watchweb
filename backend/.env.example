NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/watchweb
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
EXTENSION_ID=
REDIS_URL=redis://127.0.0.1:6379

# Optional AI-generated change summaries. Leave AI_PROVIDER=none to use the
# deterministic (non-AI) summary generator instead.
AI_PROVIDER=none
AI_API_KEY=

MAX_WATCHES_PER_USER=50
MIN_CHECK_INTERVAL=15
MAX_RESPONSE_SIZE=5242880
MAX_PAGE_LOAD_TIME=30000
MAX_CONCURRENT_PAGES=5
SNAPSHOT_RETENTION_DAYS=90
